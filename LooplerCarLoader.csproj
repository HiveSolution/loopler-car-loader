<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LooplerCarLoader</AssemblyName>
    <RootNamespace>LooplerCarLoader</RootNamespace>
    <Version>1.0.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Override with -p:GameDir="..." or the LOOPLER_GAME_DIR environment variable. -->
    <GameDir Condition="'$(GameDir)' == '' And '$(LOOPLER_GAME_DIR)' != ''">$(LOOPLER_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">G:\Steam\steamapps\common\The Loopler</GameDir>
    <PluginDir>$(GameDir)\BepInEx\plugins\LooplerCarLoader</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- Generated by BepInEx on the first game start (and again after every game update). -->
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckInterop" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDir)\BepInEx\interop\Assembly-CSharp.dll')"
           Text="No interop assemblies in '$(GameDir)\BepInEx\interop'. Start the game once with BepInEx installed, or pass -p:GameDir=..." />
  </Target>

  <!-- dotnet build -p:Deploy=true copies the plugin into the game. -->
  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Message Importance="high" Text="Deployed to $(PluginDir)" />
  </Target>

</Project>
